# Maintainer: Mark Relph
#
# NOTE (electron version): Arch pins Electron apps to a specific major rather
# than the floating `electron` meta-package (obsidian and element-desktop use
# electron43, code uses electron42), because the meta-package Provides nothing
# and simply depends on the current major. $_electron below is the single source
# of truth: it drives both depends=() and the installed launcher. Bumping
# Electron means changing that one line, rebuilding, and re-testing.

pkgname=inkwell
pkgver=0.1.2
pkgrel=1
pkgdesc="A calm, local-first Markdown reader and editor for Linux"
arch=('any')
url="https://github.com/mrelph/inkwell"
license=('MIT')
_electron=electron43
depends=("${_electron}" 'hicolor-icon-theme')
makedepends=('pnpm' 'nodejs')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('bff289be5afd3bc70d4fea34898c863b945116100d4c3cb8e5e574376e248f1c')

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  # pnpm needs a writable home/store dir inside the build sandbox.
  export HOME="${srcdir}"
  export npm_config_store_dir="${srcdir}/.pnpm-store"

  # The `electron` devDependency exists only for its TypeScript types; the
  # packaged app execs the *system* electron. Skip its ~100MB postinstall
  # binary download, which would otherwise be fetched and then never used.
  export ELECTRON_SKIP_BINARY_DOWNLOAD=1

  pnpm install --frozen-lockfile
  pnpm build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  install -d "${pkgdir}/usr/lib/${pkgname}"
  cp -r dist "${pkgdir}/usr/lib/${pkgname}/dist"
  cp -r dist-electron "${pkgdir}/usr/lib/${pkgname}/dist-electron"
  install -Dm644 package.json "${pkgdir}/usr/lib/${pkgname}/package.json"

  # Normalize permissions on the copied trees: directories 755, files 644.
  find "${pkgdir}/usr/lib/${pkgname}/dist" "${pkgdir}/usr/lib/${pkgname}/dist-electron" \
    -type d -exec chmod 755 {} \;
  find "${pkgdir}/usr/lib/${pkgname}/dist" "${pkgdir}/usr/lib/${pkgname}/dist-electron" \
    -type f -exec chmod 644 {} \;

  # Launcher: exec the system Electron against the installed app directory,
  # forwarding all arguments so `inkwell notes.md` opens that file.
  install -d "${pkgdir}/usr/bin"
  cat > "${pkgdir}/usr/bin/${pkgname}" <<'EOF'
#!/bin/bash
# Exec the system Electron against the installed app, forwarding arguments so
# `inkwell notes.md` opens that file. The binary is pinned by the PKGBUILD's
# $_electron and guaranteed present by depends=().
exec @ELECTRON@ /usr/lib/inkwell "$@"
EOF
  sed -i "s|@ELECTRON@|${_electron}|" "${pkgdir}/usr/bin/${pkgname}"
  chmod 755 "${pkgdir}/usr/bin/${pkgname}"

  install -Dm644 packaging/inkwell.desktop "${pkgdir}/usr/share/applications/${pkgname}.desktop"
  install -Dm644 build/icon.png "${pkgdir}/usr/share/icons/hicolor/512x512/apps/${pkgname}.png"
  install -Dm644 build/icon.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/${pkgname}.svg"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
